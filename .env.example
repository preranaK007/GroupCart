# Spectrum Cloud credentials for your existing dedicated iMessage line.
PROJECT_ID=your_spectrum_project_id
PROJECT_SECRET=your_spectrum_project_secret

# iMessage handles that are allowed to contribute in the household group.
# Use each participant's exact phone/email identity as Spectrum reports it.
GROUP_CART_MEMBERS=+15555550100=Alex,+15555550101=Maya

GROUP_CART_HOUSEHOLD=apartment-4b
GROUP_CART_DB=./data/groupcart.sqlite
GROUP_CART_BUDGET_CENTS=5000
PORT=3000
# Public browser URL used in the account sign-in link. Keep this local until a protected public URL is deployed.
GROUP_CART_PUBLIC_URL=http://127.0.0.1:3000

# Recurring weekly/biweekly/monthly list check-ins sent to the household group (live mode).
# Set GROUP_CART_LIST_REMINDERS=off to disable. The hour is server-local time (0-23).
GROUP_CART_LIST_REMINDERS=on
GROUP_CART_LIST_REMINDER_HOUR=9
GROUP_CART_LIST_REMINDER_CHECK_MINUTES=15

# Kroger Production Developer app (live catalog search; never commit real credentials)
KROGER_CLIENT_ID=your_kroger_client_id
KROGER_CLIENT_SECRET=your_kroger_client_secret
# Register this exact callback URL in the Kroger developer app's redirect URI list.
KROGER_REDIRECT_URI=http://127.0.0.1:3000/api/kroger/oauth/callback
# Cart API requires a fulfillment modality; PICKUP is the default, DELIVERY is also supported.
KROGER_CART_MODALITY=PICKUP
# Optional until you select a Kroger-family store; needed for location-specific pricing
KROGER_LOCATION_ID=
