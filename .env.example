# Spectrum Cloud credentials for your existing dedicated iMessage line.
PROJECT_ID=your_spectrum_project_id
PROJECT_SECRET=your_spectrum_project_secret

# iMessage handles that are allowed to contribute in the household group (explicit allowlist).
# Comma-separated handle=Name entries. Give one person several handles with |, e.g. phone|Apple ID email=Name;
# people added to an existing group often appear under their Apple ID email instead of their phone.
# Handles are normalized: emails are lowercased; phones drop spaces, dashes, dots, and parentheses, and
# 10-digit US numbers become +1XXXXXXXXXX. Restart GroupCart after changing this list.
GROUP_CART_MEMBERS=+15555550100=Alex,+15555550101|maya@example.com=Maya

GROUP_CART_HOUSEHOLD=apartment-4b
GROUP_CART_DB=./data/groupcart.sqlite
GROUP_CART_BUDGET_CENTS=5000
PORT=3000
# Network access is opt-in. Leave unset (127.0.0.1) for this computer only; 0.0.0.0 serves your LAN.
# Other devices must sign in at /signin with a code GroupCart texts them by iMessage.
# GROUP_CART_HOST=0.0.0.0
# Public browser URL used in the account sign-in link. Keep this local until a protected public URL is deployed.
# AI assistants (claude.ai, ChatGPT & dots, Grok): to reach /mcp from outside, run `cloudflared tunnel --url http://127.0.0.1:3000`
# and set this to the https://….trycloudflare.com address. Through the tunnel only /mcp, /oauth/*, and /.well-known/*
# answer; keep the Kroger/Google redirect URIs below on 127.0.0.1.
GROUP_CART_PUBLIC_URL=http://127.0.0.1:3000

# Recurring weekly/biweekly/monthly list check-ins sent to the household group (live mode).
# Set GROUP_CART_LIST_REMINDERS=off to disable. The hour is server-local time (0-23).
GROUP_CART_LIST_REMINDERS=on
GROUP_CART_LIST_REMINDER_HOUR=9
GROUP_CART_LIST_REMINDER_CHECK_MINUTES=15

# Kroger Production Developer app (live catalog search; never commit real credentials)
KROGER_CLIENT_ID=your_kroger_client_id
KROGER_CLIENT_SECRET=your_kroger_client_secret
# Register this exact callback URL in the Kroger developer app's redirect URI list.
KROGER_REDIRECT_URI=http://127.0.0.1:3000/api/kroger/oauth/callback
# Cart API requires a fulfillment modality; PICKUP is the default, DELIVERY is also supported.
KROGER_CART_MODALITY=PICKUP
# Optional until you select a Kroger-family store; needed for location-specific pricing
KROGER_LOCATION_ID=

# Splitwise (optional). When all three are set, each Kroger-confirmed checkout is logged
# as one expense in this Splitwise group. Unset = simulated (nothing is sent).
# Personal API key from https://secure.splitwise.com/apps (never commit a real key).
SPLITWISE_API_KEY=your_splitwise_api_key
# Numeric id of the household's Splitwise group (from the group page URL).
SPLITWISE_GROUP_ID=12345678
# GroupCart member name = Splitwise user id or email (names as in GROUP_CART_MEMBERS).
SPLITWISE_MEMBERS=Alex=12345,Maya=maya@example.com
# Google Calendar (optional; free/busy only). Leave unset to show sample schedules on /calendar.
# Create an OAuth 2.0 "Web application" client in Google Cloud, enable the Google Calendar API,
# and register this exact redirect URI. Each household member connects their own calendar.
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_REDIRECT_URI=http://127.0.0.1:3000/api/google/oauth/callback
# Bill reading (optional). With a key, bill photos/PDFs sent to the group or uploaded on /bills are
# read with Claude vision. Without it, they wait as "needs reading" drafts that a member's own Claude
# reads through the GroupCart connector, or that someone types in ("bill internet $80 due Nov 1").
ANTHROPIC_API_KEY=your_anthropic_api_key
# Optional model override (default claude-opus-5-5).
ANTHROPIC_MODEL=
